import discord
import os
import random

intents = discord.Intents.default()
intents.message_content = True

client = discord.Client(intents=intents)

energy_facts = {
    "tv": [
        "Lowering TV brightness reduces electricity use.",
        "Turning off standby mode saves energy.",
        "LED TVs are more energy efficient than older models."
    ],
    "phone": [
        "Unplugging chargers saves phantom energy.",
        "Dark mode saves power on OLED screens.",
        "Charging only when needed saves electricity."
    ],
    "light": [
        "LED bulbs use up to 80% less energy.",
        "Turning lights off when leaving saves power.",
        "Smart bulbs reduce wasted electricity."
    ],
    "computer": [
        "Laptops use less power than desktops.",
        "Sleep mode saves energy when not in use.",
        "Lower screen brightness saves electricity."
    ],
    "fridge": [
        "Keeping the fridge full helps it run efficiently.",
        "Older fridges use much more electricity.",
        "Opening the fridge less often saves energy."
    ]
}

@client.event
async def on_ready():
    print("Bot is online")

@client.event
async def on_message(message):
    if message.author == client.user:
        return

    content = message.content.lower()

    for key in energy_facts:
        if key in content:
            fact = random.choice(energy_facts[key])
            await message.channel.send(f"🔋 {fact}")
            return

    await message.channel.send("❌ I can’t help with that.")

client.run(os.getenv("##################################################"))

