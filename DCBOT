import discord
from discord.ext import commands
import os
import random


intents = discord.Intents.default()
intents.message_content = True


bot = commands.Bot(command_prefix="!", intents=intents)

energy_facts = {
    "tv": ["Lowering TV brightness reduces electricity use.", "LED TVs are more energy efficient."],
    "phone": ["Unplugging chargers saves phantom energy.", "Dark mode saves power on OLED screens."],
    "light": ["LED bulbs use up to 80% less energy.", "Turning lights off saves power."],
    "computer": ["Laptops use less power than desktops.", "Sleep mode saves energy."],
    "fridge": ["Keeping the fridge full helps it run efficiently.", "Older fridges use more electricity."]
}

@bot.event
async def on_ready():
    print(f"Logged in as {bot.user}")


@bot.command()
async def energy(ctx, category: str = None):

    if category and category.lower() in energy_facts:
        fact = random.choice(energy_facts[category.lower()])
        await ctx.send(f"🔋 **Tip:** {fact}")
    else:
        options = ", ".join(energy_facts.keys())
        await ctx.send(f"❓ Please provide a category! Options: {options}")


bot.run("###############################################")
